<odoo>
    <record id="product_template_form_sii_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.sii</field>
        <field name="model">product.template</field>
        <field name="priority">6</field>
        <field name="inherit_id" ref="account.product_template_form_view" />
        <field name="arch" type="xml">
            <!-- 20.0 quito el grupo "properties" del formulario de producto; la
                 causa de exencion va a la pagina de contabilidad. -->
            <xpath expr="//page[@name='invoicing']" position="inside">
                <separator string="SII" />
                <group>
                    <field name="sii_exempt_cause" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
