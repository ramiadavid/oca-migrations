<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-name="sale_order_line_price_history.price_history_widget">
        <a
            t-if="this.props.record.data.qty_invoiced === 0"
            tabindex="0"
            t-on-click="this.viewPriceHistory"
            class="fa fa-history"
            title="Price History"
        />
    </t>
</templates>
