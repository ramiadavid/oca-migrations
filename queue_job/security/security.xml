<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="res.groups.privilege" id="privilege_queue_job">
        <field name="name">Job Queue</field>
        <field name="sequence">50</field>
    </record>
    <record model="ir.module.category" id="module_category_queue_job">
        <field name="name">Job Queue</field>
        <field name="sequence">20</field>
    </record>
    <record id="group_queue_job_manager" model="res.groups">
        <field name="name">Job Queue Manager</field>
        <field name="privilege_id" ref="privilege_queue_job" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>
    <!--
        The multi-company record rule lives in security/ir.access.csv since
        20.0: ir.rule was merged into ir.access, where an access with no
        group_id and a domain is a global restriction.
    -->
</odoo>
